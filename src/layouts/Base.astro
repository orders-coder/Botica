---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  robots?: string;
  includeJsonLd?: boolean;
}

const {
  title,
  description,
  robots = "index, follow",
  includeJsonLd = false,
} = Astro.props;
const site = Astro.site ?? new URL("https://boticasf.com/");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: "Botica SF",
  url: "https://boticasf.com/",
  image: ogImage,
  logo: new URL("/icon-512.png", site).href,
  description:
    "Botica SF is an apothecary-themed cafe opening at 448 Larkin Street in San Francisco's Tenderloin. Ecuadorian-inspired coffee and food, juice by day, mocktails by night.",
  servesCuisine: "Coffee",
  address: {
    "@type": "PostalAddress",
    streetAddress: "448 Larkin Street",
    addressLocality: "San Francisco",
    addressRegion: "CA",
    addressCountry: "US",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F7F2EA" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Botica SF" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Botica wordmark in script beside a mortar, pestle, and coffee sprig."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preload"
      href="/fonts/BoticaRelic-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      includeJsonLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
