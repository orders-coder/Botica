---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const description =
  "Botica SF is an apothecary-themed cafe opening at 448 Larkin Street in San Francisco's Tenderloin. Ecuadorian-inspired coffee and food, juice by day, mocktails by night.";

const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=448%20Larkin%20Street%2C%20San%20Francisco%2C%20CA";

const menu = [
  {
    id: "coffee",
    title: "Coffee",
    items: [
      { name: "Espresso", note: "A short pull." },
      { name: "Cortado", note: "Espresso with a little warm milk." },
      { name: "Filter", note: "Brewed by the cup." },
      { name: "Honey latte", note: "Espresso, warm milk, and honey." },
    ],
  },
  {
    id: "juices",
    title: "Juices",
    items: [
      { name: "Green press", note: "Cucumber, apple, and lime." },
      { name: "Citrus", note: "Orange and grapefruit." },
      { name: "Beet", note: "Beet, apple, and ginger." },
      { name: "Fruit cooler", note: "Seasonal fruit and water." },
    ],
  },
  {
    id: "food",
    title: "Food",
    items: [
      { name: "Morning pastry", note: "Baked that day." },
      { name: "Savory tart", note: "A warm slice." },
      { name: "Grain plate", note: "Grains, herbs, and something pickled." },
      { name: "Small cake", note: "A single slice." },
    ],
  },
  {
    id: "elixirs",
    title: "Evening elixirs",
    items: [
      { name: "Botanical highball", note: "Herbs, citrus, and soda." },
      { name: "Rose cordial", note: "Fruit and a floral syrup." },
      { name: "Cacao", note: "Cacao, chile, and cold milk." },
      { name: "Citrus tonic", note: "Lemon, seeds, and tonic." },
    ],
  },
];
---

<Base
  title="Botica SF — Apothecary cafe on Larkin Street"
  description={description}
  includeJsonLd
>
  <Header />
  <main id="content">
    <section class="hero wrap section" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Opening soon</p>
        <h1 id="hero-title">
          <img
            class="logo-word"
            src="/brand/botica-logo-green.svg"
            width="3872"
            height="716"
            alt="Botica"
          />
        </h1>
        <p class="lede">
          An apothecary cafe on Larkin Street. Ecuadorian-inspired coffee and
          food, juice by day, elixirs by night.
        </p>
        <p class="hero-address">
          <a href="#visit">448 Larkin Street, San Francisco</a>
        </p>
        <div class="hero-actions">
          <a class="btn btn-solid" href="#menu">Preview the menu</a>
          <a class="btn btn-ghost" href="#opening">Join the list</a>
        </div>
      </div>
      <div class="hero-mark">
        <img
          src="/brand/mark-green.svg"
          width="960"
          height="960"
          alt="Botica mark: a mortar, pestle, and a sprig topped by a coffee bean"
        />
      </div>
    </section>

    <section class="section" id="concept" aria-labelledby="concept-title">
      <div class="wrap">
        <div class="concept-copy">
          <p class="eyebrow">The house</p>
          <h2 id="concept-title">By day, a cafe. By night, elixirs.</h2>
          <p class="lede">
            Botica is Spanish for apothecary. At 448 Larkin Street that means a
            short list of drinks, natural materials, and a room with no sharp
            edges.
          </p>
        </div>

        <div class="split">
          <article class="niche niche-day">
            <img
              class="niche-icon"
              src="/brand/mark-green.svg"
              width="960"
              height="960"
              alt=""
            />
            <p class="eyebrow">Day</p>
            <h3>Coffee and juice</h3>
            <p>
              By day, Botica is a coffee and juice bar. The coffee and the food
              are Ecuadorian-inspired.
            </p>
          </article>
          <article class="niche niche-night on-green">
            <div class="niche-lockup">
              <img
                class="niche-icon"
                src="/brand/mark-cream.svg"
                width="960"
                height="960"
                alt=""
              />
              <img
                class="logo-word"
                src="/brand/botica-logo-cream.svg"
                width="3872"
                height="716"
                alt="Botica"
              />
            </div>
            <p class="eyebrow">Night</p>
            <h3>Mocktails</h3>
            <p>
              By night, the bar pours mocktails. Beer and wine are planned for
              later.
            </p>
          </article>
        </div>

        <p class="room">
          The room has no sharp edges. Sculpted plaster, arched niches, and
          clay-like benches. The bar and the tables are redwood. The chairs are
          wood.
        </p>
        <ul class="materials">
          <li>Sculpted plaster</li>
          <li>Arched niches</li>
          <li>Clay-like benches</li>
          <li>Redwood bar and tables</li>
          <li>Wood chairs</li>
        </ul>
      </div>
    </section>

    <section class="section" id="menu" aria-labelledby="menu-title">
      <div class="wrap">
        <div class="menu-panel">
          <p class="eyebrow">The menu</p>
          <h2 id="menu-title">A preview, not the list</h2>
          <div class="notice" role="note">
            <p>
              <strong>Placeholder menu.</strong> Every name below is a stand-in
              for this page. These are not the opening drinks or dishes, and
              nothing here has a price.
            </p>
          </div>
          <div class="menu-grid">
            {
              menu.map((group) => (
                <section class="menu-group" aria-labelledby={`${group.id}-title`}>
                  <h3 id={`${group.id}-title`}>{group.title}</h3>
                  <p class="tag">Placeholder</p>
                  <ul class="menu-list">
                    {group.items.map((item) => (
                      <li data-placeholder="true">
                        <p class="item-name">{item.name}</p>
                        <p class="item-note">
                          <span class="visually-hidden">Placeholder. </span>
                          {item.note}
                        </p>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="visit" aria-labelledby="visit-title">
      <div class="wrap visit-grid">
        <div>
          <p class="eyebrow">Visit</p>
          <h2 id="visit-title">448 Larkin Street</h2>
          <p class="visit-place">
            San Francisco, California<br />
            Tenderloin
          </p>
          <div class="visit-actions">
            <a
              class="btn btn-solid"
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Google Maps
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
            <a
              class="text-link"
              href="https://www.instagram.com/boticasf"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
              <span class="visually-hidden">
                (placeholder, opens in a new tab)</span
              >
            </a>
            <span class="tag">Placeholder</span>
          </div>
        </div>
        <aside class="hours on-green" aria-labelledby="hours-title">
          <div class="hours-stamp">
            <img src="/brand/mark-cream.svg" width="960" height="960" alt="" />
          </div>
          <p class="eyebrow" id="hours-title">Hours</p>
          <p class="hours-value">TBA</p>
          <p>Placeholder. Opening hours are not set.</p>
        </aside>
      </div>
    </section>

    <section class="section" id="opening" aria-labelledby="opening-title">
      <div class="wrap">
        <div class="signup on-green">
          <p class="eyebrow">The list</p>
          <h2 id="opening-title">Opening soon</h2>
          <p class="help">
            Leave an email and we will write once, when the door opens.
          </p>
          <form
            class="signup-form"
            action="/subscribe"
            method="post"
            data-signup
            data-placeholder="true"
          >
            <label for="email">Email</label>
            <div class="signup-row">
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="254"
                placeholder="you@example.com"
                aria-describedby="signup-help"
              />
              <button class="btn btn-solid" type="submit">Notify me</button>
            </div>
            <p class="form-note" id="signup-help">
              Placeholder form. It posts to /subscribe on this server and is
              not connected to a mailing list. Sending it does not add you to
              one. When a list is connected, the address will be used only to
              announce the opening.
            </p>
            <p class="form-status" data-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.querySelector("[data-signup]");
  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", (event) => {
      if (form.dataset.placeholder !== "true") return;
      event.preventDefault();

      const status = form.querySelector("[data-status]");
      const email = form.querySelector('input[type="email"]');
      if (!(status instanceof HTMLElement) || !(email instanceof HTMLInputElement)) {
        return;
      }

      if (!email.validity.valid) {
        email.reportValidity();
        status.textContent = "Enter a valid email address.";
        return;
      }

      status.textContent =
        "Thanks. Nothing was sent. This form is still a placeholder and is not connected to a mailing list.";
      form.reset();
    });
  }
</script>
